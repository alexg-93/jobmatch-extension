{
  "manifest_version": 3,
  "name": "JobMatch — Resume Matcher (LinkedIn, Drushim, AllJobs, Comeet, Greenhouse)",
  "version": "0.11.3",
  "version_name": "0.11.3-refactor",
  "description": "Upload your resume once. See your match score, strengths, and gap analysis on LinkedIn, Drushim, AllJobs, Comeet, and Greenhouse, powered by Gemini AI and local models.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.drushim.co.il/*",
    "https://drushim.co.il/*",
    "https://*.alljobs.co.il/*",
    "https://alljobs.co.il/*",
    "https://*.comeet.com/*",
    "https://comeet.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content/widget.js", "content/base-adapter.js", "content/linkedin.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.drushim.co.il/*",
        "https://drushim.co.il/*"
      ],
      "js": ["content/widget.js", "content/base-adapter.js", "content/drushim.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.alljobs.co.il/*",
        "https://alljobs.co.il/*"
      ],
      "js": ["content/widget.js", "content/base-adapter.js", "content/alljobs.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.comeet.com/jobs/*",
        "https://comeet.com/jobs/*"
      ],
      "js": ["content/widget.js", "content/base-adapter.js", "content/comeet.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*"
      ],
      "js": ["content/widget.js", "content/base-adapter.js", "content/greenhouse.js"],
      "css": ["content/widget.css"],
      "run_at": "document_idle"
    }
  ]
}
